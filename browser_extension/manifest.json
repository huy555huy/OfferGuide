{
  "manifest_version": 3,
  "name": "OfferGuide Boss 助手",
  "version": "0.3.0",
  "description": "BOSS直聘 JD 自动评分 + 推荐列表 sync + 一键写开场白. 半自动求职助手, 不替你按发送.",

  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://www.zhipin.com/*",
    "https://zhipin.com/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/job_detail/*",
        "https://zhipin.com/job_detail/*",
        "https://www.zhipin.com/web/chat/*",
        "https://zhipin.com/web/chat/*"
      ],
      "js": ["content_script_jd.js"],
      "run_at": "document_idle"
    }
  ]
}
